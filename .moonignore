# Explicit Mooncakes publishing boundary. Development artifacts stay out.
/*
!/.moonignore
!/moon.mod
!/README.md
!/CHANGELOG.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY.md
!/src/
!/src/**
!/benchmarks/
/benchmarks/*
!/benchmarks/manifest.json
!/docs/
/docs/*
!/docs/API.md
!/docs/TREE_DIFF.md
!/docs/TREE_SNAPSHOT.md
!/docs/ACCEPTANCE.md
!/docs/COMPATIBILITY.md
!/docs/COMPATIBILITY_MATRIX.md
!/docs/NEXT_RELEASES.md
!/docs/PERFORMANCE.md
!/docs/SCIENTIFIC_WORKFLOWS.md
!/docs/REVIEW_EVIDENCE-v0.0.9.md
!/docs/FORMAT.md
!/docs/JSON.md
!/docs/RECIPES.md
!/docs/DIFFERENTIATION.md
!/docs/ITERATIONS-v0.0.3.md
!/examples/
/examples/*
!/examples/sample.mat
!/examples/sample.json
!/examples/transform-plan.json
!/examples/python/
!/examples/python/**
!/examples/matlab/
!/examples/matlab/**
!/examples/octave/
!/examples/octave/**
!/examples/registry_consumer/
!/examples/registry_consumer/**
!/examples/mixed/
!/examples/mixed/**
!/examples/workflows/
!/examples/workflows/**

/examples/python/__pycache__/

!/examples/compatibility/
!/examples/compatibility/**

!/docs/SOURCES.md

!/docs/TREE_CLOSE.md

!/docs/NAME_ENCODING.md
!/examples/unicode/
!/examples/unicode/**

!/docs/HISTORY.md
