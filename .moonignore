# Explicit Mooncakes publishing boundary. Development artifacts stay out.
/*
!/.moonignore
!/moon.mod
!/README.md
!/CHANGELOG.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY.md
!/src/
!/src/**
!/docs/
/docs/*
!/docs/API.md
!/docs/COMPATIBILITY.md
!/docs/FORMAT.md
!/docs/JSON.md
!/docs/RECIPES.md
!/docs/DIFFERENTIATION.md
!/docs/ITERATIONS-v0.0.3.md
!/examples/
/examples/*
!/examples/sample.mat
!/examples/sample.json
!/examples/transform-plan.json
!/examples/python/
!/examples/python/**
!/examples/matlab/
!/examples/matlab/**
!/examples/registry_consumer/
!/examples/registry_consumer/**
!/examples/mixed/
!/examples/mixed/**

/examples/python/__pycache__/
