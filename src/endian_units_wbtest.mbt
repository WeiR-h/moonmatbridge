///|
// Independent SciPy numeric planes include NaN payloads, negative zero, exact
// uint64, odd counts and an empty multidimensional value in a big-endian file.
test "big-endian storage units retain exact bytes across memory and short sources" {
  let bytes = b"\x4d\x41\x54\x4c\x41\x42\x20\x35\x2e\x30\x20\x4d\x41\x54\x2d\x66\x69\x6c\x65\x2c\x20\x72\x65\x70\x72\x6f\x64\x75\x63\x69\x62\x6c\x65\x20\x4d\x6f\x6f\x6e\x4d\x61\x74\x42\x72\x69\x64\x67\x65\x20\x6d\x69\x78\x65\x64\x2d\x74\x79\x70\x65\x20\x66\x69\x78\x74\x75\x72\x65\x20\x28\x53\x63\x69\x50\x79\x20\x70\x72\x6f\x64\x75\x63\x65\x72\x29\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x4d\x49\x00\x00\x00\x0e\x00\x00\x00\x40\x00\x00\x00\x06\x00\x00\x00\x08\x00\x00\x00\x0a\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x08\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\x77\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x06\x01\x23\x80\x00\xff\xff\x00\x00\x00\x00\x00\x0e\x00\x00\x00\x48\x00\x00\x00\x06\x00\x00\x00\x08\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x08\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\x77\x34\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x0c\x7f\xc0\x00\x42\x80\x00\x00\x00\x3f\x80\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0e\x00\x00\x00\x50\x00\x00\x00\x06\x00\x00\x00\x08\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x08\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\x77\x38\x00\x00\x00\x00\x00\x00\x00\x00\x00\x09\x00\x00\x00\x18\x7f\xf8\x00\x00\x00\x00\x00\x42\x80\x00\x00\x00\x00\x00\x00\x00\x3f\xf0\x00\x00\x00\x00\x00\x01\x00\x00\x00\x0e\x00\x00\x00\x50\x00\x00\x00\x06\x00\x00\x00\x08\x00\x00\x00\x0f\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x08\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\x75\x38\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0d\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x80\x00\x00\x00\x00\x00\x00\x11\x00\x00\x00\x0e\x00\x00\x00\x40\x00\x00\x00\x06\x00\x00\x00\x08\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x08\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\x77\x31\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x03\x00\x80\xff\x00\x00\x00\x00\x00\x00\x00\x00\x0e\x00\x00\x00\x40\x00\x00\x00\x06\x00\x00\x00\x08\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x0c\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x05\x65\x6d\x70\x74\x79\x00\x00\x00\x00\x00\x00\x09\x00\x00\x00\x00"
  let tree = read_tree(bytes)
  for
    (name, expected) in [
      ("w2", b"\x23\x01\x00\x80\xff\xff"),
      ("w4", b"\x42\x00\xc0\x7f\x00\x00\x00\x80\x01\x00\x80\x3f"),
      (
        "w8", b"\x42\x00\x00\x00\x00\x00\xf8\x7f\x00\x00\x00\x00\x00\x00\x00\x80\x01\x00\x00\x00\x00\x00\xf0\x3f",
      ),
      (
        "u8", b"\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x11\x00\x00\x00\x00\x00\x00\x80",
      ),
      ("w1", b"\x00\x80\xff"),
      ("empty", b""),
    ] {
    match tree.select([name])[0] {
      Numeric(a) => assert_true(a.real == expected)
      _ => assert_true(false)
    }
  }
  for chunk in [1, 3, 5, 7] {
    let source = test_source(bytes, 1)
    let limits = { ..default_source_limits(), chunk_bytes: chunk, }
    assert_true(
      compare_trees(tree, read_tree_from(source, limits~)).content_equal,
    )
    assert_true(
      compare_trees(
        read_selected(bytes, ["w8", "w4", "w2"]),
        read_selected_from(source, ["w8", "w4", "w2"], limits~),
      ).content_equal,
    )
  }
}
